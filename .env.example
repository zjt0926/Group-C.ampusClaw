# ===== 服务端基础配置（复制为 .env 后按需修改；.env 不入仓库）=====
SECRET_KEY=change-me-to-a-random-string
JWT_SECRET=change-me-to-another-random-string
JWT_MAX_AGE=28800
COOKIE_SECURE=0

# ===== 数据库与队列 =====
# Docker Compose 会自动注入容器内地址；本地直跑可用 SQLite
DATABASE_URL=postgresql+psycopg2://campusclaw:campusclaw@db:5432/campusclaw
REDIS_URL=redis://redis:6379/0

# ===== 课程 AI 网关（密钥只放服务端，禁止提交）=====
# 留空时启用本地演示生成器，链路仍可完整走通
AI_GATEWAY_BASE_URL=
AI_GATEWAY_API_KEY=
AI_GATEWAY_MODEL=gpt-4o-mini
AI_TIMEOUT_SECONDS=90

# ===== 业务参数 =====
PASS_SCORE=60
WEB_PORT=8000
